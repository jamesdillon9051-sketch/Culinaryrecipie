# Weekly Delight — host rules for the live site.
#
# The site is served by Hostinger, which reads this file; netlify.toml and
# vercel.json in this repository are for the two hosts it is not on, and
# neither of them was doing anything about the problem below.
#
# Every page was reachable on two hostnames. https://weeklydelight.com/ and
# https://www.weeklydelight.com/ both returned 200 with the same content, and
# both carried a canonical pointing at the apex. Google honoured the canonical
# and filed all 943 www copies as "Alternate page with proper canonical tag",
# which is Search Console reporting a duplicate it resolved rather than an
# error — but it means half of what the crawler fetched was a second copy of a
# page it already had.
#
# One host, one URL. The redirect is 301 so the resolution is permanent and
# any link equity on a www URL moves to the apex.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Private files: answered 404, as if they were not there.
  #
  # The whole repository is deployed into the web root, so the recipe source,
  # the build and audit tools, the project notes and the working CSV and JSON
  # files were all downloadable by anyone who guessed a path. robots.txt used to
  # list /src/ and /tools/, which only asks crawlers not to look and tells
  # everyone else where to. The real fix is to deploy only the built site
  # (README, "Deploying"); these rules are the server refusing in the meantime.
  # tools/private-paths-check.js tests them, and with --url tests a live host.
  # images-attribution.md stays public: it is the photo credits.
  RewriteRule ^(?:src|tools|docs|backups|logs|node_modules|\.git|\.github|\.humanize|\.wide|\.netlify|\.vercel)(?:/|$) - [R=404,L,NC]
  RewriteRule ^(?:CLAUDE\.md|README\.md|MISSING-IMAGES\.txt|package(?:-lock)?\.json|netlify\.toml|vercel\.json|_redirects|suspects\.json|\.gitignore|\.nojekyll|\.env)$ - [R=404,L,NC]
  RewriteRule \.(?:csv|py|pyc|sh|bak|log|jsonl)$ - [R=404,L,NC]

  # The contact form's result pages are templates for contact/send.php, which
  # fills them in. They are not pages to browse, and the old thank-you addresses
  # (which said "Message sent" to anyone who typed them) go to the form.
  RewriteRule ^contact/_pages(?:/|$) - [R=404,L,NC]
  RewriteRule ^contact/(?:success|not-sent)/?$ /contact/ [R=302,L,NC]

  # Recipes taken down because another page is the same dish
  # (src/data/retired-recipes.json). Each old address, with or without its
  # trailing slash or index.html, and from www or http, goes to the page that
  # stays in one permanent hop. tools/retired-recipes-check.js holds these
  # lines to the list.
  RewriteRule ^recipes/australian-cheese-and-vegemite-scrolls(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/vegemite-scrolls/ [R=301,L,NC]
  RewriteRule ^recipes/fluffy-pancakes(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/buttermilk-pancakes/ [R=301,L,NC]
  RewriteRule ^recipes/sticky-date-cake(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/sticky-date-pudding/ [R=301,L,NC]
  RewriteRule ^recipes/slow-cooker-split-pea-soup(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/slow-cooker-pea-and-ham-soup/ [R=301,L,NC]
  RewriteRule ^recipes/chicken-tagine-olives(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/moroccan-chicken-tagine/ [R=301,L,NC]
  RewriteRule ^recipes/potato-salad(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/classic-potato-salad/ [R=301,L,NC]
  RewriteRule ^recipes/coleslaw(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/creamy-coleslaw/ [R=301,L,NC]
  RewriteRule ^recipes/naan(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/garlic-naan/ [R=301,L,NC]
  RewriteRule ^recipes/kartoffelsalat(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/german-potato-salad/ [R=301,L,NC]
  RewriteRule ^recipes/grilled-cheese(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/grilled-cheese-sandwich/ [R=301,L,NC]
  RewriteRule ^recipes/lamb-rogan-josh(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/rogan-josh/ [R=301,L,NC]
  RewriteRule ^recipes/moules-mariniere(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/moules-marinieres/ [R=301,L,NC]
  RewriteRule ^recipes/pork-schnitzel(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/schnitzel/ [R=301,L,NC]
  RewriteRule ^recipes/pulled-pork-sandwich(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/pulled-pork/ [R=301,L,NC]
  RewriteRule ^recipes/sfiha(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/sfiha-baalbakieh/ [R=301,L,NC]
  RewriteRule ^recipes/sloppy-joe-mix(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/sloppy-joes/ [R=301,L,NC]
  RewriteRule ^recipes/fish-goujons(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/homemade-fish-sticks/ [R=301,L,NC]
  RewriteRule ^recipes/spaghetti-al-limone(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/pasta-al-limone/ [R=301,L,NC]
  RewriteRule ^recipes/spring-onion-pancakes(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/scallion-pancakes/ [R=301,L,NC]
  RewriteRule ^recipes/air-fryer-baked-potato(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/air-fryer-jacket-potato/ [R=301,L,NC]
  RewriteRule ^recipes/slow-cooker-macaroni-and-cheese(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/slow-cooker-mac-and-cheese/ [R=301,L,NC]
  RewriteRule ^recipes/katsu-curry(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/chicken-katsu-curry/ [R=301,L,NC]
  RewriteRule ^recipes/devilled-eggs(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/deviled-eggs/ [R=301,L,NC]
  RewriteRule ^recipes/tajarin-al-tartufo(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/tagliolini-al-tartufo/ [R=301,L,NC]
  RewriteRule ^recipes/one-pan-chicken-and-rice(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/one-pot-chicken-and-rice/ [R=301,L,NC]
  RewriteRule ^recipes/beetroot-burger(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/beet-burgers/ [R=301,L,NC]
  RewriteRule ^recipes/slow-cooker-chilli-con-carne(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/slow-cooker-chili/ [R=301,L,NC]
  RewriteRule ^recipes/kumara-fries(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/sweet-potato-fries/ [R=301,L,NC]
  RewriteRule ^recipes/sweet-potato-gnocchi(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/kumara-gnocchi/ [R=301,L,NC]
  RewriteRule ^recipes/fruit-loaf(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/tea-loaf/ [R=301,L,NC]
  RewriteRule ^recipes/honey-mustard-sausages(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/cocktail-sausages/ [R=301,L,NC]
  RewriteRule ^recipes/new-zealand-anzac-biscuits(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/anzac-biscuits/ [R=301,L,NC]
  RewriteRule ^recipes/chicken-francoise(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/chicken-francese/ [R=301,L,NC]
  RewriteRule ^recipes/shepherds-pie-with-cheesy-mash(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/shepherds-pie/ [R=301,L,NC]
  RewriteRule ^recipes/collard-greens-with-ham-hock(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/collard-greens/ [R=301,L,NC]
  RewriteRule ^recipes/potato-gratin(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/gratin-dauphinois/ [R=301,L,NC]
  RewriteRule ^recipes/3-ingredient-cookies(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/three-ingredient-peanut-butter-cookies/ [R=301,L,NC]
  RewriteRule ^recipes/trout-with-almonds(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/trout-almondine/ [R=301,L,NC]
  RewriteRule ^recipes/carbonade-flamande(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/carbonnade-flamande/ [R=301,L,NC]
  RewriteRule ^recipes/toffee-popcorn(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/caramel-popcorn/ [R=301,L,NC]
  RewriteRule ^recipes/beef-pot-roast-with-gravy(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/pot-roast/ [R=301,L,NC]
  RewriteRule ^recipes/slow-cooked-lamb-shoulder(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/roast-lamb-shoulder/ [R=301,L,NC]
  RewriteRule ^recipes/rack-of-lamb(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/herb-crusted-rack-of-lamb/ [R=301,L,NC]
  RewriteRule ^recipes/no-bake-energy-bites(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/energy-balls/ [R=301,L,NC]
  RewriteRule ^recipes/peanut-butter-energy-bites(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/energy-balls/ [R=301,L,NC]
  RewriteRule ^recipes/breakfast-cookies(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/banana-oat-breakfast-cookies/ [R=301,L,NC]
  RewriteRule ^recipes/new-zealand-boil-up(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/boil-up/ [R=301,L,NC]
  RewriteRule ^recipes/roasted-beet-salad-with-goat-cheese(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/beetroot-and-goat-cheese-salad/ [R=301,L,NC]
  RewriteRule ^recipes/banana-toast(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/peanut-butter-banana-toast/ [R=301,L,NC]
  RewriteRule ^recipes/fruit-salad-with-honey-lime(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/fruit-salad/ [R=301,L,NC]
  RewriteRule ^recipes/fish-pie-with-cheddar-mash(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/fish-pie/ [R=301,L,NC]
  RewriteRule ^recipes/fish-and-chips-with-mushy-peas(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/fish-and-chips/ [R=301,L,NC]
  RewriteRule ^recipes/chewy-oat-granola-bars(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/homemade-granola-bars/ [R=301,L,NC]
  RewriteRule ^recipes/onion-turkey-burgers(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/turkey-burgers/ [R=301,L,NC]
  RewriteRule ^recipes/loaded-baked-potatoes(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/loaded-baked-potato/ [R=301,L,NC]
  RewriteRule ^recipes/irish-potato-cakes(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/leftover-mashed-potato-cakes/ [R=301,L,NC]
  RewriteRule ^recipes/zucchini-bake(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/zucchini-slice/ [R=301,L,NC]
  RewriteRule ^recipes/shortbread-fingers(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/shortbread/ [R=301,L,NC]
  RewriteRule ^recipes/shortbread-stars(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/shortbread/ [R=301,L,NC]
  RewriteRule ^recipes/shortbread-cookies(?:/(?:index\.html)?)?$ https://weeklydelight.com/recipes/shortbread/ [R=301,L,NC]

  # A listing page that no longer has enough recipes to be built (see RETIRED_HUBS in src/build.js).
  RewriteRule ^categories/appetizers/new-zealand(?:/(?:index\.html)?)?$ https://weeklydelight.com/cuisines/new-zealand/ [R=301,L,NC]

  # /path/index.html -> /path/
  #
  # The same duplicate as www, from the other direction. DirectoryIndex serves
  # /recipes/pad-thai/ out of /recipes/pad-thai/index.html, and Apache will
  # also serve that file to anyone who asks for it by name — so every one of
  # the 946 pages answered 200 at two URLs with identical content, and the
  # canonical tag was the only thing telling Google which to keep. That is
  # exactly what "Alternate page with proper canonical tag" reports: a
  # duplicate found and resolved. Resolved still costs the crawl.
  #
  # Nothing on the site links this way — every internal link, canonical and
  # sitemap entry uses the trailing slash, and tools/seo-audit.js fails the
  # build if one does not — so this only ever catches a URL guessed or
  # remembered from outside.
  #
  # The condition is on THE_REQUEST, not the rewritten path, and that is what
  # stops it looping: THE_REQUEST holds the original request line and is not
  # touched by internal redirects, so when mod_dir maps /foo/ onto
  # /foo/index.html the rule sees "GET /foo/" and does not fire. It fires only
  # when the client asked for index.html by name, and the redirect it sends
  # cannot match it a second time.
  #
  # First, and to an absolute apex URL, so a www or http request for an
  # index.html arrives at its final address in one hop rather than being
  # handed on to the two rules below.
  RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*?)index\.html$ https://weeklydelight.com/$1 [R=301,L,NE]

  # www -> apex, preserving scheme, path and query.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # http -> https. Already in place upstream, kept here so the rule set is
  # complete if the host in front of this ever changes.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# The build writes directory-style pages, so /recipes/pad-thai/ is served by
# /recipes/pad-thai/index.html. The trailing slash is the canonical form and
# every canonical tag, internal link and sitemap entry uses it.
DirectoryIndex index.html

ErrorDocument 404 /404.html

# ---------------------------------------------------------------- performance
#
# Compression and caching. Neither was set here, so whatever the host's default
# was is what visitors got: a repeat visit re-downloaded the stylesheet, the
# fonts and every photograph it had already seen. These are guarded with
# IfModule so a host without the module ignores them rather than failing.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml application/rss+xml image/svg+xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  # Pages keep for ten minutes, matching max-age below. An Expires of "now"
  # told the CDN not to cache them at all (see the Cache-Control note).
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  # Photographs keep their file names when one is swapped for a better picture,
  # so they get a month, not a year. Fonts never change under their name.
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  # The stylesheet and scripts are linked with ?v=<hash>, so a changed file has
  # a new URL and the old one can be kept for a year.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images: a month, and "no-transform". Hostinger's CDN was re-encoding
  # every JPG and PNG on the way out (24 October 2026): a .jpg asked for by a
  # browser that accepts WebP came back as a WebP larger than the original
  # (168 KB for a 119 KB photograph), every other request got a re-encoded
  # JPEG, and the re-encode dropped the IPTC "trainedAlgorithmicMedia" mark
  # tools/mark-illustrations.js writes into each AI illustration. Some of those
  # requests were answered 429 with an empty body while the .webp copies of
  # the same pictures, which the CDN passes through untouched, answered 200.
  # no-transform is the HTTP instruction to a proxy not to alter a response;
  # if the CDN still converts, switch off its image optimisation in hPanel.
  <FilesMatch "\.(webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=2592000, no-transform"
  </FilesMatch>
  # Pages, sitemaps and feeds: browsers may keep a copy for ten minutes
  # (max-age), the CDN in front (Hostinger, "server: hcdn") for an hour
  # (s-maxage). With max-age=0 the CDN treated nearly every page as uncacheable
  # ("x-hcdn-cache-status: DYNAMIC"), even with s-maxage added, so each crawler
  # request went through to the hosting server, and Hostinger's CDN answers
  # rapid uncached requests with HTTP 429 (Hostinger confirmed the 429s come
  # from the CDN layer, not from these rules). Search Console listed the pages
  # as "Discovered - currently not indexed", the status Google gives when it
  # holds back so as not to overload a site. Files the CDN did cache, such as
  # robots.txt (max-age=3600) and the stylesheet, all carry a real max-age.
  # The cost: a reader may see a page up to ten minutes old, and a deploy can
  # take up to an hour to reach every CDN edge unless the CDN cache is cleared
  # in hPanel. Header set applies to successful responses only, so a 404 is
  # never cached this way.
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=600, s-maxage=3600"
  </FilesMatch>
</IfModule>
