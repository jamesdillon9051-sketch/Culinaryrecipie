{
  "name": "weekly-delight",
  "version": "1.0.0",
  "private": true,
  "description": "Weekly Delight \u2014 a dependency-free static site for the world's most famous recipes.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node src/build.js",
    "images": "node tools/image-inventory.js",
    "icons": "python3 tools/make_icons.py",
    "attribution": "node tools/make-attribution.js",
    "missing": "node tools/missing-images.js",
    "serve": "npm run build && node tools/serve.js",
    "check": "node tools/check.js",
    "readme": "node tools/sync-readme.js",
    "diet": "node tools/diet-audit.js",
    "timing": "node tools/timing-audit.js",
    "nutrition": "node tools/nutrition-audit.js",
    "health": "node tools/health-audit.js",
    "food": "node tools/food-handling-audit.js",
    "calc": "node tools/nutrition-calc.js",
    "keywords": "node tools/keyword-audit.js",
    "seo": "node tools/seo-audit.js",
    "duplicates": "node tools/duplicates-audit.js",
    "dedupe": "node tools/dedupe-candidates.js",
    "voice": "node tools/voice-audit.js",
    "backup": "node tools/backup.js",
    "humanize": "node tools/humanize.js",
    "selftest": "node tools/humanize-selftest.js",
    "contact-test": "node tools/contact-test.js",
    "contact-browser-test": "node tools/contact-browser-test.js",
    "site-browser-test": "node tools/site-browser-test.js",
    "package": "node tools/package-public.js"
  },
  "keywords": [
    "recipes",
    "static-site",
    "food",
    "seo",
    "vanilla-js"
  ]
}
